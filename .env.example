DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
PORT=3100
STORAGE_DIR=.storage

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# Qwen answer client: API key stays on the server; DASHSCOPE_API_KEY is also supported.
# Set the Base URL for the same region/workspace as the key, without /chat/completions.
# Beijing example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Alibaba direct access has no default region or model. Use non-streaming text chat.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Alternative: a regular OpenRouter inference key (not a Management API Key).
# With only this key, Qwen uses https://openrouter.ai/api/v1 and qwen/qwen-plus.
# QWEN_BASE_URL/QWEN_MODEL can explicitly override that route/model.
OPEN_ROUTER_KEY=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

# Native answer providers: explicit model IDs, server-side keys only.
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Pause new claims below this estimated available-memory percentage (0..100).
WORKER_MIN_AVAILABLE_PERCENT=10

# PDF 单文件上传上限（MB）
PDF_MAX_SIZE_MB=30
