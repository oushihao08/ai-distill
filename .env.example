# 文件职责：提供本地服务环境变量模板；只填写开发环境值，不放真实凭证。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
PORT=3700
STORAGE_DIR=.storage

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# PDF extraction defaults to the direct MinerU API, then falls back to the MinerU CLI.
# Set PDF_EXTRACTION_PROVIDER=mineru-cli to force the CLI path.
PDF_EXTRACTION_PROVIDER=
MINERU_KEY=
# Optional absolute path; default: .storage/tools/mineru-open-api
MINERU_CLI_PATH=

# Qwen answer client: API key stays on the server; DASHSCOPE_API_KEY is also supported.
# Set the Base URL for the same region/workspace as the key, without /chat/completions.
# Beijing example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Alibaba direct access has no default region or model. Use non-streaming text chat.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Alternative: a regular OpenRouter inference key (not a Management API Key).
# With only this key, Qwen uses https://openrouter.ai/api/v1 and qwen/qwen-plus.
# QWEN_BASE_URL/QWEN_MODEL can explicitly override that route/model.
OPEN_ROUTER_KEY=
SILICONFLOW_API_KEY=

# Native answer providers: explicit model IDs, server-side keys only.
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Pause new claims below this estimated available-memory percentage (0..100).
WORKER_MIN_AVAILABLE_PERCENT=10

# Shared execution limits; valid range is 1..32. Values are read when each service starts.
# local processes local materials and Agent queues; api processes local model API queues; all processes both.
# server processes server-owned intake, extraction, API redaction and answer queues without Agent/scoring.
WORKER_MODE=local
# 仅服务器 worker 设为 server；本机保持 local。034 迁移必须先完成。
MATERIAL_EXECUTION_TARGET=local
# 远程材料与作答 CLI/API 共用；同一固定随机令牌至少 32 字符，不提交真实值。
REMOTE_MATERIAL_TOKEN=
# 本机 CLI 通过 SSH 隧道连接服务器回环 API，例如 http://127.0.0.1:37900。
REMOTE_MATERIAL_API_URL=
# Agent calls share these slots across the worker and the HTTP connection-test endpoint.
# 两项分别优先使用环境变量；未设置或留空才读取本机 SQLite 设置，再回退 Agent 2/API 8。
# 环境变量有效范围 1..32；非法值报错。修改后重启 API 与 worker。
AGENT_CONCURRENCY=2
# Model answering and API-mode redaction share one limit in the supported single worker.
LLM_API_CONCURRENCY=8

# PDF 单文件上传上限（MB）
PDF_MAX_SIZE_MB=50

# Independent large-model API defaults for API-mode business steps (e.g. redaction).
# Defaults to openrouter / deepseek/deepseek-v4.1-flash with thinking disabled; reuses OPEN_ROUTER_KEY above.
# Override with qwen / kimi / deepseek / doubao / openrouter when needed.
# LLM_API_BASE_URL is optional for providers with a standard endpoint; Qwen native requires the correct region/workspace URL.
# Step settings select from the shared model catalog; no repeated API URL setup.
# Credentials still use the matching provider variables above; never store keys in step settings.
LLM_API_PROVIDER=openrouter
LLM_API_MODEL=deepseek/deepseek-v4.1-flash
LLM_API_BASE_URL=

# Number of project workflows loaded and dispatched per batch chunk; defaults to 100, valid range 1..1000.
BATCH_DISPATCH_CHUNK_SIZE=100

# 基础 skill 模板；留空变量请删除或注释，默认 templates/company-legal-task。
# 相对目录以仓库根目录解析；也可指定外部绝对目录。
# SKILL_BASE_TEMPLATE_DIR=templates/company-legal-task
