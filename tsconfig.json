{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts"
  ]
}
